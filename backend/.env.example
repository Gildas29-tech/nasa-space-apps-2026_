# FieldShift Backend Configuration
# Copy this file to .env and fill in your values

# App
APP_NAME=FieldShift API
APP_VERSION=1.0.0
DEBUG=true

# CORS (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# NASA POWER API (no key required for basic usage)
NASA_POWER_BASE_URL=https://power.larc.nasa.gov/api/temporal/daily/point
NASA_POWER_TIMEOUT=30

# Supabase (optional - for data persistence)
# Get these from your Supabase project settings
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-role-key

# Sentinel Hub (optional - for satellite imagery)
# Get these from https://apps.sentinel-hub.com/
SENTINEL_HUB_CLIENT_ID=your-client-id
SENTINEL_HUB_CLIENT_SECRET=your-client-secret

# Cache
CACHE_TTL_SECONDS=3600